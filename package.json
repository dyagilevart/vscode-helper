{
  "name": "lumos",
  "displayName": "Lumos",
  "description": "Карточка текущей задачи из Naumen Project Ruler по git-ветке",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:lumos.webview",
    "onCommand:lumos.signIn",
    "onCommand:lumos.signOut",
    "onCommand:lumos.refresh"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Lumos",
      "properties": {
        "lumos.baseUrl": {
          "type": "string",
          "default": "",
          "markdownDescription": "Базовый URL Project Ruler, например `https://project-ruler.example.com` (без `/sd`)."
        },
        "lumos.taskMetaClass": {
          "type": "string",
          "default": "GMtask",
          "description": "Метакласс задачи для REST search."
        },
        "lumos.branchPattern": {
          "type": "string",
          "default": "ACRM-\\d+",
          "description": "Regex для извлечения номера задачи из имени git-ветки."
        }
      }
    },
    "views": {
      "lumos-developerum": [
        {
          "type": "webview",
          "id": "lumos.webview",
          "name": "Task",
          "icon": "images/icon.svg"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "lumos-developerum",
          "title": "Lumos",
          "icon": "images/icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "lumos.signIn",
        "title": "Lumos: Sign In"
      },
      {
        "command": "lumos.signOut",
        "title": "Lumos: Sign Out"
      },
      {
        "command": "lumos.refresh",
        "title": "Lumos: Refresh Task Card",
        "icon": "$(refresh)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "lumos.refresh",
          "when": "view == lumos.webview",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "webpack",
    "watch": "webpack --watch",
    "package": "webpack --mode production --devtool hidden-source-map",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.82.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@typescript-eslint/eslint-plugin": "^8.39.0",
    "@typescript-eslint/parser": "^8.39.0",
    "eslint": "^9.32.0",
    "typescript": "^5.9.2",
    "ts-loader": "^9.5.2",
    "webpack": "^5.101.0",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2"
  }
}
